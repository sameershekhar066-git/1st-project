---
// Navbar.astro - 100% Thai Navigation Bar & Mobile Controls Drawer (No Language Switcher)
const isWorkspace = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<header id="navbar" class="fixed top-0 left-0 right-0 h-12 z-50 bg-[var(--color-canvas)]/95 backdrop-blur-md border-b border-[var(--color-hairline)] text-[var(--color-ink)] select-none transition-colors duration-200">
  {isWorkspace && (
    <>
      <!-- Desktop Layout (Single Row on md: and above) -->
      <div class="hidden md:flex max-w-[1920px] mx-auto h-full items-center justify-between px-3 gap-3">
        
        <!-- Left Section: Logo & Edge Toggles & Tool HUD -->
        <div class="flex items-center gap-2">
          <!-- Brand Logo -->
          <a href="/" class="flex items-center gap-2 mr-1 px-1.5 py-1 rounded hover:bg-[var(--color-surface-1)] transition-colors group shrink-0" title="ไม้บรรทัด.com — ไม้บรรทัดออนไลน์ ขนาดจริง">
            <div class="w-6 h-6 rounded-lg bg-[var(--color-surface-1)] border border-[var(--color-hairline)] flex items-center justify-center text-[#5e6ad2] group-hover:border-[#5e6ad2]/50 transition-colors shadow-sm overflow-hidden p-0.5 shrink-0">
              <img src="/favicon.svg" alt="ไม้บรรทัด.com" class="w-full h-full object-contain" width="24" height="24" />
            </div>
            <span class="text-[13px] font-semibold tracking-tight text-[var(--color-ink)] leading-tight">ไม้บรรทัด<span class="text-[#5e6ad2]">.com</span></span>
          </a>

          <div class="w-px h-4 bg-[var(--color-hairline)]"></div>

          <!-- Edge Selection Buttons with Tooltips (Thai) -->
          <div class="flex items-center bg-[var(--color-surface-1)] p-0.5 rounded-md border border-[var(--color-hairline)] gap-0.5">
            <div class="tooltip-wrap" data-tooltip="ไม้บรรทัดขอบบน (Alt+T)">
              <button id="edge-top" data-edge="top" class="edge-btn px-2 py-1 text-[11px] font-medium rounded text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-all flex items-center gap-1 cursor-pointer" aria-pressed="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="4" rx="1" stroke="currentColor" stroke-width="1.5"></rect></svg>
                <span class="hidden xl:inline">บน</span>
              </button>
            </div>
            <div class="tooltip-wrap" data-tooltip="ไม้บรรทัดขอบล่าง (Alt+B)">
              <button id="edge-bottom" data-edge="bottom" class="edge-btn px-2 py-1 text-[11px] font-medium rounded text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-all flex items-center gap-1 cursor-pointer" aria-pressed="false">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><rect x="2" y="10" width="12" height="4" rx="1" stroke="currentColor" stroke-width="1.5"></rect></svg>
                <span class="hidden xl:inline">ล่าง</span>
              </button>
            </div>
            <div class="tooltip-wrap" data-tooltip="ไม้บรรทัดขอบซ้าย (Alt+L)">
              <button id="edge-left" data-edge="left" class="edge-btn px-2 py-1 text-[11px] font-medium rounded text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-all flex items-center gap-1 cursor-pointer" aria-pressed="true">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.5"></rect></svg>
                <span class="hidden xl:inline">ซ้าย</span>
              </button>
            </div>
            <div class="tooltip-wrap" data-tooltip="ไม้บรรทัดขอบขวา (Alt+R)">
              <button id="edge-right" data-edge="right" class="edge-btn px-2 py-1 text-[11px] font-medium rounded text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-all flex items-center gap-1 cursor-pointer" aria-pressed="false">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><rect x="10" y="2" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.5"></rect></svg>
                <span class="hidden xl:inline">ขวา</span>
              </button>
            </div>
          </div>

          <div class="w-px h-4 bg-[var(--color-hairline)]"></div>

          <!-- Interactive Tools HUD with Tooltips -->
          <div class="flex items-center bg-[var(--color-surface-1)] p-0.5 rounded-md border border-[var(--color-hairline)] gap-0.5">
            <!-- 2D Object Sizer Box -->
            <div class="tooltip-wrap" data-tooltip="กล่องวัดวัตถุ 2D (S)">
              <button id="tool-sizer" data-tool="sizer" class="tool-btn p-1.5 rounded text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-all flex items-center justify-center cursor-pointer" aria-pressed="false">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <rect x="2.5" y="2.5" width="11" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3" stroke-dasharray="2 2"></rect>
                  <path d="M6 8h4M8 6v4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>

            <!-- Crosshair -->
            <div class="tooltip-wrap" data-tooltip="เป้าเล็งกากบาท (C)">
              <button id="tool-crosshair" data-tool="crosshair" class="tool-btn p-1.5 rounded text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-all flex items-center justify-center cursor-pointer" aria-pressed="false">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"></circle>
                  <line x1="8" y1="1" x2="8" y2="5" stroke="currentColor" stroke-width="1.3"></line>
                  <line x1="8" y1="11" x2="8" y2="15" stroke="currentColor" stroke-width="1.3"></line>
                  <line x1="1" y1="8" x2="5" y2="8" stroke="currentColor" stroke-width="1.3"></line>
                  <line x1="11" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.3"></line>
                </svg>
              </button>
            </div>

            <!-- Guide Lines -->
            <div class="tooltip-wrap" data-tooltip="เส้นไกด์วัดขนาด (G)">
              <button id="tool-guides" data-tool="guides" class="tool-btn p-1.5 rounded text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-all flex items-center justify-center cursor-pointer" aria-pressed="false">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <line x1="8" y1="1" x2="8" y2="15" stroke="currentColor" stroke-width="1.3"></line>
                  <line x1="1" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.3"></line>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Right Section: Units · Calibrate CTA · Theme Toggle · HowTo · Fullscreen -->
        <div class="flex items-center gap-2 justify-end">
          
          <!-- Unit Selector (Segmented Pill with Tooltips) -->
          <div class="unit-group flex items-center bg-[var(--color-surface-1)] p-0.5 rounded-md border border-[var(--color-hairline)]">
            <div class="tooltip-wrap" data-tooltip="เซนติเมตร (cm)">
              <button data-unit="cm" class="unit-btn px-2 py-0.5 text-[11px] font-medium font-mono rounded transition-colors text-[var(--color-ink)] bg-[var(--color-surface-3)] shadow-sm cursor-pointer">cm</button>
            </div>
            <div class="tooltip-wrap" data-tooltip="มิลลิเมตร (mm)">
              <button data-unit="mm" class="unit-btn px-2 py-0.5 text-[11px] font-medium font-mono rounded transition-colors text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] cursor-pointer">mm</button>
            </div>
            <div class="tooltip-wrap" data-tooltip="นิ้ว (in)">
              <button data-unit="in" class="unit-btn px-2 py-0.5 text-[11px] font-medium font-mono rounded transition-colors text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] cursor-pointer">in</button>
            </div>
            <div class="tooltip-wrap" data-tooltip="พิกเซลหน้าจอ (px)">
              <button data-unit="px" class="unit-btn px-2 py-0.5 text-[11px] font-medium font-mono rounded transition-colors text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] cursor-pointer">px</button>
            </div>
          </div>

          <!-- Calibrate Button (Primary CTA) -->
          <div class="tooltip-wrap" data-tooltip="ปรับเทียบขนาดหน้าจอ (K)">
            <button id="btn-calibrate" class="btn-calibrate-trigger flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[var(--color-surface-1)] border border-[var(--color-hairline)] hover:border-[#5e6ad2]/50 text-[var(--color-ink)] text-[12px] font-medium transition-all group shadow-sm cursor-pointer">
              <span id="cal-status-indicator" class="cal-status-dot w-2 h-2 rounded-full bg-[#f5a623] group-hover:scale-110 transition-transform"></span>
              <span class="tracking-tight">ปรับเทียบจอ</span>
              <span id="nav-ppi-readout" class="nav-ppi-text text-[10px] font-mono text-[var(--color-ink-subtle)] ml-0.5 hidden lg:inline">96 PPI</span>
            </button>
          </div>

          <!-- Dark / Light Mode Toggle Button -->
          <div class="tooltip-wrap" data-tooltip="สลับโหมดมืด / สว่าง (D)">
            <button id="btn-theme-toggle" class="btn-theme-trigger p-1.5 rounded-md bg-[var(--color-surface-1)] border border-[var(--color-hairline)] text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-colors cursor-pointer" aria-label="สลับโหมดสี">
              <svg class="theme-icon-moon hidden" width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M13.5 9.5A5.5 5.5 0 016.5 2.5a5.5 5.5 0 107 7z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <svg class="theme-icon-sun" width="14" height="14" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"></circle>
                <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>

          <!-- MPA Pages Nav Links (Desktop) -->
          <nav class="hidden lg:flex items-center gap-1 text-[11px] font-medium text-[var(--color-ink-subtle)] mr-0.5">
            <a href="/about" class="px-1.5 py-1 rounded hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-1)] transition-colors">เกี่ยวกับเรา</a>
            <a href="/privacy-policy" class="px-1.5 py-1 rounded hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-1)] transition-colors">ความเป็นส่วนตัว</a>
            <a href="/terms" class="px-1.5 py-1 rounded hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-1)] transition-colors">ข้อกำหนด</a>
            <a href="/contact" class="px-1.5 py-1 rounded hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-1)] transition-colors">ติดต่อเรา</a>
          </nav>

          <div class="w-px h-4 bg-[var(--color-hairline)] hidden lg:block"></div>

          <!-- How to Use (?) -->
          <div class="tooltip-wrap" data-tooltip="วิธีใช้งานและคีย์ลัด (?)">
            <button id="btn-howto" class="btn-howto-trigger p-1.5 rounded-md bg-[var(--color-surface-1)] border border-[var(--color-hairline)] text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-colors cursor-pointer" aria-label="วิธีใช้งาน">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"></circle>
                <path d="M6.5 6.5C6.5 5.5 7.2 4.8 8 4.8C8.8 4.8 9.5 5.5 9.5 6.3C9.5 7.2 8.5 7.6 8 8.3V9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                <circle cx="8" cy="11.5" r="0.75" fill="currentColor"></circle>
              </svg>
            </button>
          </div>

          <!-- Fullscreen Toggle (F) -->
          <div class="tooltip-wrap" data-tooltip="เต็มหน้าจอ (F)">
            <button id="btn-fullscreen" class="btn-fullscreen-trigger p-1.5 rounded-md bg-[var(--color-surface-1)] border border-[var(--color-hairline)] text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] transition-colors cursor-pointer" aria-label="โหมดเต็มหน้าจอ">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Top Header (< md) -->
      <div class="flex md:hidden h-full items-center justify-between px-2.5 gap-1.5">
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-1.5 shrink-0" title="ไม้บรรทัด.com">
          <div class="w-5 h-5 rounded-lg bg-[var(--color-surface-1)] border border-[var(--color-hairline)] flex items-center justify-center p-0.5">
            <img src="/favicon.svg" alt="ไม้บรรทัด.com" class="w-full h-full object-contain" width="20" height="20" />
          </div>
          <span class="text-[12px] font-semibold tracking-tight text-[var(--color-ink)]">ไม้บรรทัด<span class="text-[#5e6ad2]">.com</span></span>
        </a>

        <!-- Unit Segment Selector (Mobile Top) -->
        <div class="unit-group flex items-center bg-[var(--color-surface-1)] p-0.5 rounded-md border border-[var(--color-hairline)] shrink-0">
          <button data-unit="cm" class="unit-btn px-1.5 py-0.5 text-[10px] font-medium font-mono rounded text-[var(--color-ink)] bg-[var(--color-surface-3)] cursor-pointer">cm</button>
          <button data-unit="mm" class="unit-btn px-1.5 py-0.5 text-[10px] font-medium font-mono rounded text-[var(--color-ink-subtle)] cursor-pointer">mm</button>
          <button data-unit="in" class="unit-btn px-1.5 py-0.5 text-[10px] font-medium font-mono rounded text-[var(--color-ink-subtle)] cursor-pointer">in</button>
          <button data-unit="px" class="unit-btn px-1.5 py-0.5 text-[10px] font-medium font-mono rounded text-[var(--color-ink-subtle)] cursor-pointer">px</button>
        </div>

        <!-- Quick Actions: Calibrate & Mobile Tools Drawer Toggle -->
        <div class="flex items-center gap-1 shrink-0">
          <button class="btn-calibrate-trigger flex items-center gap-1.5 px-2 py-1 rounded-md bg-[var(--color-surface-1)] border border-[var(--color-hairline)] hover:border-[#5e6ad2]/50 text-[var(--color-ink)] text-[11px] font-medium shadow-sm active:scale-95 transition-all cursor-pointer">
            <span class="cal-status-dot w-2 h-2 rounded-full bg-[#f5a623] shrink-0"></span>
            <span class="tracking-tight">ปรับเทียบจอ</span>
          </button>

          <!-- Mobile Tools & Settings Drawer Toggle Button -->
          <button id="btn-mobile-drawer" class="p-1.5 rounded-md bg-[var(--color-surface-1)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] flex items-center gap-1 transition-all cursor-pointer" aria-label="เมนูเครื่องมือ">
            <svg id="drawer-icon-open" width="14" height="14" viewBox="0 0 16 16" fill="none">
              <rect x="2" y="3" width="12" height="2" rx="0.5" fill="currentColor"></rect>
              <rect x="2" y="7" width="12" height="2" rx="0.5" fill="currentColor"></rect>
              <rect x="2" y="11" width="12" height="2" rx="0.5" fill="currentColor"></rect>
            </svg>
            <svg id="drawer-icon-close" class="hidden" width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Controls Drawer (Overlay Below Top Navbar) -->
      <div id="mobile-controls-drawer" class="md:hidden hidden bg-[var(--color-canvas)] border-b border-[var(--color-hairline)] px-3.5 py-3 shadow-2xl space-y-3 transition-colors duration-200">
        
        <!-- Edge Rulers Selector Section (4 Edges) -->
        <div class="space-y-1">
          <span class="text-[10px] font-mono text-[var(--color-ink-subtle)] uppercase tracking-wider">เลือกด้านไม้บรรทัด</span>
          <div class="grid grid-cols-4 gap-1 bg-[var(--color-surface-2)] p-1 rounded-lg border border-[var(--color-hairline)]">
            <button data-edge="top" class="edge-btn py-1.5 text-[11px] font-medium rounded text-center text-[var(--color-ink)] bg-[var(--color-surface-3)] cursor-pointer" aria-pressed="true">บน</button>
            <button data-edge="bottom" class="edge-btn py-1.5 text-[11px] font-medium rounded text-center text-[var(--color-ink-subtle)] cursor-pointer" aria-pressed="false">ล่าง</button>
            <button data-edge="left" class="edge-btn py-1.5 text-[11px] font-medium rounded text-center text-[var(--color-ink)] bg-[var(--color-surface-3)] cursor-pointer" aria-pressed="true">ซ้าย</button>
            <button data-edge="right" class="edge-btn py-1.5 text-[11px] font-medium rounded text-center text-[var(--color-ink-subtle)] cursor-pointer" aria-pressed="false">ขวา</button>
          </div>
        </div>

        <!-- Measurement Tools Section -->
        <div class="space-y-1">
          <span class="text-[10px] font-mono text-[var(--color-ink-subtle)] uppercase tracking-wider">เครื่องมือช่วยวัด</span>
          <div class="grid grid-cols-3 gap-1 bg-[var(--color-surface-2)] p-1 rounded-lg border border-[var(--color-hairline)]">
            <button data-tool="sizer" class="tool-btn py-2 text-center text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] flex items-center justify-center rounded transition-colors cursor-pointer" aria-pressed="false" title="กล่องวัด 2D (S)">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2.5" y="2.5" width="11" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3" stroke-dasharray="2 2"></rect><path d="M6 8h4M8 6v4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></svg>
            </button>
            <button data-tool="crosshair" class="tool-btn py-2 text-center text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] flex items-center justify-center rounded transition-colors cursor-pointer" aria-pressed="false" title="เป้าเล็ง (C)">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"></circle><line x1="8" y1="1" x2="8" y2="5" stroke="currentColor" stroke-width="1.3"></line><line x1="8" y1="11" x2="8" y2="15" stroke="currentColor" stroke-width="1.3"></line><line x1="1" y1="8" x2="5" y2="8" stroke="currentColor" stroke-width="1.3"></line><line x1="11" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.3"></line></svg>
            </button>
            <button data-tool="guides" class="tool-btn py-2 text-center text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] flex items-center justify-center rounded transition-colors cursor-pointer" aria-pressed="false" title="เส้นไกด์ (G)">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><line x1="8" y1="1" x2="8" y2="15" stroke="currentColor" stroke-width="1.3"></line><line x1="1" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.3"></line></svg>
            </button>
          </div>
        </div>

        <!-- Quick Utilities Row: Theme · Guide -->
        <div class="grid grid-cols-2 gap-1.5 pt-1 border-t border-[var(--color-hairline)] text-[12px]">
          <!-- Theme Toggle -->
          <button class="btn-theme-trigger py-2 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[var(--color-ink)] hover:bg-[var(--color-surface-3)] transition-all cursor-pointer" aria-label="สลับโหมดสี" title="สลับโหมดมืด / สว่าง (D)">
            <svg class="theme-icon-moon hidden" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M13.5 9.5A5.5 5.5 0 016.5 2.5a5.5 5.5 0 107 7z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"></circle><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
          </button>

          <!-- Guide Button -->
          <button class="btn-howto-trigger py-2 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-hairline)] flex items-center justify-center text-[var(--color-ink)] hover:bg-[var(--color-surface-3)] transition-all cursor-pointer" title="วิธีใช้งานและคีย์ลัด (?)">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"></circle>
              <path d="M6.5 6.5C6.5 5.5 7.2 4.8 8 4.8C8.8 4.8 9.5 5.5 9.5 6.3C9.5 7.2 8.5 7.6 8 8.3V9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
              <circle cx="8" cy="11.5" r="0.75" fill="currentColor"></circle>
            </svg>
          </button>
        </div>

        <!-- MPA Page Links (Mobile Drawer) -->
        <div class="grid grid-cols-4 gap-1 pt-1.5 border-t border-[var(--color-hairline)] text-[10px] text-center font-medium">
          <a href="/about" class="py-1.5 rounded-lg bg-[var(--color-surface-2)] text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] transition-colors">เกี่ยวกับเรา</a>
          <a href="/privacy-policy" class="py-1.5 rounded-lg bg-[var(--color-surface-2)] text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] transition-colors">ความเป็นส่วนตัว</a>
          <a href="/terms" class="py-1.5 rounded-lg bg-[var(--color-surface-2)] text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] transition-colors">ข้อกำหนด</a>
