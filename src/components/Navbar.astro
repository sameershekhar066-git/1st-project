          <img src="/favicon.svg" alt="ไม้บรรทัด.com" class="w-full h-full object-contain" width="20" height="20" />
        </div>
        <span class="text-[12px] sm:text-[13px] font-semibold tracking-tight text-[var(--color-ink)] leading-tight">ไม้บรรทัด<span class="text-[#5e6ad2]">.com</span></span>
