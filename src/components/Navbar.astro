  {!isWorkspace && (
    <div class="max-w-4xl mx-auto h-full flex items-center justify-between px-2.5 sm:px-6 gap-1 sm:gap-4">
      <a href="/" class="flex items-center gap-1.5 px-1 py-1 rounded hover:bg-[var(--color-surface-1)] transition-colors group shrink-0" title="ไม้บรรทัด.com — ไม้บรรทัดออนไลน์ ขนาดจริง">
