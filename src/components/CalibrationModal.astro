---
// CalibrationModal.astro - 100% Thai Display Calibration Modal
---

<div id="calibration-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-4 bg-black/70 backdrop-blur-md hidden select-none">
  <div class="bg-[var(--color-surface-1)] border border-[var(--color-hairline)] rounded-2xl shadow-2xl w-full max-w-[520px] max-h-[90dvh] sm:max-h-[92vh] flex flex-col overflow-hidden text-[var(--color-ink)]">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-4 sm:px-6 pt-3.5 sm:pt-5 pb-3 sm:pb-4 border-b border-[var(--color-hairline)] shrink-0">
      <div>
        <h2 class="text-[15px] sm:text-[17px] font-semibold tracking-tight text-[var(--color-ink)]">ปรับเทียบขนาดหน้าจอ (Calibration)</h2>
      </div>
      <button id="close-cal-btn" class="w-8 h-8 rounded-lg text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] flex items-center justify-center transition-colors cursor-pointer" aria-label="ปิดหน้าต่าง">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
    </div>

    <!-- Calibration Method Tabs -->
    <div class="flex items-center gap-1 px-3 sm:px-6 pt-2.5 sm:pt-4 bg-[var(--color-surface-1)] shrink-0 overflow-x-auto no-scrollbar">
      <button data-tab="auto" class="cal-tab-btn flex-1 py-2 px-1.5 sm:px-2 text-[11px] sm:text-[12px] font-medium rounded-lg text-center transition-all bg-[var(--color-surface-2)] text-[var(--color-ink)] border border-[var(--color-hairline-strong)] shrink-0 cursor-pointer">
        ตรวจจับอัตโนมัติ
      </button>
      <button data-tab="device" class="cal-tab-btn flex-1 py-2 px-1.5 sm:px-2 text-[11px] sm:text-[12px] font-medium rounded-lg text-center transition-all text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] shrink-0 cursor-pointer">
        เลือกรุ่นอุปกรณ์
      </button>
      <button data-tab="diagonal" class="cal-tab-btn flex-1 py-2 px-1.5 sm:px-2 text-[11px] sm:text-[12px] font-medium rounded-lg text-center transition-all text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] shrink-0 cursor-pointer">
        เส้นทแยงมุม
      </button>
      <button data-tab="card" class="cal-tab-btn flex-1 py-2 px-1.5 sm:px-2 text-[11px] sm:text-[12px] font-medium rounded-lg text-center transition-all text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] shrink-0 cursor-pointer">
        ทาบบัตรประชาชน/เครดิต
      </button>
    </div>

    <!-- Tab Panels Container -->
    <div class="p-3.5 sm:p-6 overflow-y-auto space-y-3.5 sm:space-y-4 flex-1 text-[13px] overscroll-contain">
      
      <!-- Panel 1: Auto-Detect (Method 1) -->
      <div id="panel-auto" class="cal-panel space-y-3.5 sm:space-y-4">
        <div class="p-3.5 sm:p-4 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-hairline)] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-subtle)] uppercase">หน้าจอที่ตรวจพบ</span>
            <span id="auto-ppi-badge" class="px-2 py-0.5 rounded-full text-[10px] sm:text-[11px] font-mono font-semibold bg-[#5e6ad2]/20 text-[#5e6ad2] border border-[#5e6ad2]/40">
              -- PPI
            </span>
          </div>
          <div class="space-y-0.5">
            <h3 id="auto-device-name" class="text-[14px] sm:text-[15px] font-semibold text-[var(--color-ink)]">
              กำลังวิเคราะห์หน้าจอ...
            </h3>
            <p id="auto-device-specs" class="text-[11px] sm:text-[12px] text-[var(--color-ink-subtle)] font-mono">
              กำลังประมวลผลความละเอียดหน้าจอและ Device Pixel Ratio...
            </p>
          </div>
        </div>

        <p class="text-[11px] sm:text-[12px] text-[var(--color-ink-muted)] leading-relaxed">
          ระบบคำนวณขนาดและสัดส่วนพิกเซลของหน้าจอคุณโดยอัตโนมัติ เพื่อปรับขนาดไม้บรรทัดออนไลน์ให้ตรงกับขนาดจริง 100%
        </p>

        <button id="apply-auto-btn" class="w-full py-2.5 rounded-xl bg-[#5e6ad2] hover:bg-[#828fff] text-white text-[12px] sm:text-[13px] font-medium transition-colors shadow-md active:scale-[0.98] cursor-pointer">
          ใช้ค่าปรับเทียบอัตโนมัติ
        </button>
      </div>

      <!-- Panel 2: Device Database Selector -->
      <div id="panel-device" class="cal-panel space-y-3 hidden">
        <div class="relative">
          <input id="device-search-input" type="text" placeholder="ค้นหารุ่นอุปกรณ์ (เช่น iPhone, Galaxy, iPad, MacBook, จอ 24 นิ้ว, 27 4K)..." class="w-full h-9 pl-8 pr-3 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-hairline)] text-[12px] text-[var(--color-ink)] placeholder-[var(--color-ink-tertiary)] focus:outline-none focus:border-[#5e6ad2] transition-colors" />
          <svg class="absolute left-2.5 top-2.5 text-[var(--color-ink-tertiary)]" width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.3"></circle><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.3"></path></svg>
        </div>

        <div id="device-list-container" class="max-h-[190px] sm:max-h-[220px] overflow-y-auto space-y-1 rounded-lg border border-[var(--color-hairline)] p-1 bg-[var(--color-surface-2)]/50">
          <!-- Populated by JavaScript -->
        </div>
      </div>

      <!-- Panel 3: Screen Diagonal (Method 2) -->
      <div id="panel-diagonal" class="cal-panel space-y-3.5 sm:space-y-4 hidden">
        <div class="space-y-1.5">
          <label class="block text-[11px] sm:text-[12px] font-medium text-[var(--color-ink)]">
            ขนาดเส้นทแยงมุมหน้าจอ (นิ้ว)
          </label>
          <div class="flex items-center gap-2">
            <input id="diagonal-input" type="number" min="4" max="120" step="0.1" placeholder="เช่น 6.1, 13.3 หรือ 27.0" class="flex-1 h-9 sm:h-10 px-3 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-hairline)] text-[12px] sm:text-[13px] text-[var(--color-ink)] font-mono focus:outline-none focus:border-[#5e6ad2] transition-colors" />
            <button id="apply-diagonal-btn" class="px-3.5 sm:px-5 h-9 sm:h-10 rounded-lg bg-[#5e6ad2] hover:bg-[#828fff] text-white text-[12px] sm:text-[13px] font-medium transition-colors shrink-0 cursor-pointer">
              คำนวณ
            </button>
          </div>
        </div>

        <!-- Common Diagonal Preset Chips -->
        <div class="space-y-1.5">
          <span class="text-[10px] font-mono text-[var(--color-ink-subtle)]">ขนาดยอดนิยม:</span>
          <div class="flex flex-wrap gap-1 sm:gap-1.5">
            <button class="diag-preset-chip px-2 sm:px-2.5 py-1 rounded bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] border border-[var(--color-hairline)] text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-muted)] transition-colors cursor-pointer" data-diag="6.1">6.1" (มือถือ)</button>
            <button class="diag-preset-chip px-2 sm:px-2.5 py-1 rounded bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] border border-[var(--color-hairline)] text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-muted)] transition-colors cursor-pointer" data-diag="6.7">6.7" (มือถือจอใหญ่)</button>
            <button class="diag-preset-chip px-2 sm:px-2.5 py-1 rounded bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] border border-[var(--color-hairline)] text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-muted)] transition-colors cursor-pointer" data-diag="10.9">10.9" (แท็บเล็ต)</button>
            <button class="diag-preset-chip px-2 sm:px-2.5 py-1 rounded bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] border border-[var(--color-hairline)] text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-muted)] transition-colors cursor-pointer" data-diag="13.3">13.3" (โน้ตบุ๊ก)</button>
            <button class="diag-preset-chip px-2 sm:px-2.5 py-1 rounded bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] border border-[var(--color-hairline)] text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-muted)] transition-colors cursor-pointer" data-diag="15.6">15.6" (โน้ตบุ๊ก)</button>
            <button class="diag-preset-chip px-2 sm:px-2.5 py-1 rounded bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] border border-[var(--color-hairline)] text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-muted)] transition-colors cursor-pointer" data-diag="24.0">24" (จอคอมฯ)</button>
            <button class="diag-preset-chip px-2 sm:px-2.5 py-1 rounded bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] border border-[var(--color-hairline)] text-[10px] sm:text-[11px] font-mono text-[var(--color-ink-muted)] transition-colors cursor-pointer" data-diag="27.0">27" (จอคอมฯ)</button>
          </div>
        </div>

        <div id="diagonal-result-box" class="p-2.5 sm:p-3 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-hairline)] flex items-center justify-between text-[11px] sm:text-[12px]">
          <span class="text-[var(--color-ink-subtle)]">ค่าความหนาแน่นหน้าจอ (CSS PPI):</span>
          <span id="diagonal-ppi-display" class="font-mono font-semibold text-[#5e6ad2]">-- PPI</span>
        </div>
      </div>

      <!-- Panel 4: Credit Card Calibration (Method 3) -->
      <div id="panel-card" class="cal-panel space-y-3 sm:space-y-3.5 hidden">
        <div class="p-2.5 sm:p-3.5 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-hairline)] space-y-1.5">
          <p class="text-[11px] sm:text-[12px] text-[var(--color-ink)] leading-relaxed">
            💳 <strong class="text-[#5e6ad2]">วางบัตรประชาชนหรือบัตรเครดิตจริงทาบบนกรอบด้านล่าง</strong> แล้วเลื่อนสไลเดอร์จนกรอบมีขนาดเท่ากับบัตรจริง
          </p>
          <div class="flex items-center justify-between text-[11px] font-mono text-[var(--color-ink-subtle)] pt-1 border-t border-[var(--color-hairline)]">
            <span>ขนาดบัตรมาตรฐาน (ID-1):</span>
            <span class="text-[var(--color-ink)] font-medium">85.60 × 53.98 มม.</span>
          </div>
        </div>

        <!-- Interactive Real-time Card Alignment Box -->
        <div class="flex items-center justify-center p-2.5 sm:p-3 rounded-xl bg-[var(--color-surface-2)]/60 border border-[var(--color-hairline)] overflow-x-auto min-h-[120px]">
          <div id="card-alignment-box" class="border-2 border-dashed border-[#5e6ad2] bg-[#5e6ad2]/10 rounded-xl flex flex-col items-center justify-center p-1.5 sm:p-2 text-center select-none shadow-sm transition-all duration-75 shrink-0">
            <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-md bg-[#5e6ad2]/20 border border-[#5e6ad2] flex items-center justify-center text-[#5e6ad2] text-[10px] sm:text-[11px] mb-0.5">💳</div>
            <p class="text-[10px] sm:text-[11px] font-bold text-[var(--color-ink)]">วางบัตรจริงทาบบนกรอบนี้</p>
            <p id="card-dimension-tag" class="text-[10px] sm:text-[11px] font-mono font-bold text-[#5e6ad2]">85.60 × 53.98 มม.</p>
          </div>
        </div>

        <!-- Slider Control -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-[11px] sm:text-[12px]">
            <span class="text-[var(--color-ink-subtle)]">ปรับสเกลขนาดบัตร:</span>
            <span id="card-ppi-readout" class="font-mono font-bold text-[#5e6ad2]">96.0 PPI</span>
          </div>
          <input id="card-slider" type="range" min="50" max="320" step="0.1" value="96" class="w-full h-6 py-2 accent-[#5e6ad2] cursor-pointer" />
        </div>

        <button id="apply-card-btn" class="w-full py-2.5 rounded-xl bg-[#5e6ad2] hover:bg-[#828fff] text-white text-[12px] sm:text-[13px] font-medium transition-colors shadow-md active:scale-[0.98] cursor-pointer">
          บันทึกการปรับเทียบ
        </button>
      </div>

    </div>

    <!-- Modal Footer Status -->
    <div class="px-4 sm:px-6 py-2 sm:py-2.5 bg-[var(--color-surface-2)] border-t border-[var(--color-hairline)] flex items-center justify-between text-[10px] sm:text-[11px] text-[var(--color-ink-subtle)] shrink-0">
      <span>ค่าความหนาแน่นพิกเซลปัจจุบัน:</span>
      <span id="modal-current-ppi-tag" class="font-mono text-[var(--color-ink)] font-medium text-right truncate ml-2">96.00 PPI</span>
    </div>

  </div>
</div>
